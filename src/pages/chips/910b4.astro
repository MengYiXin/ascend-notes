---
import { getEntry } from 'astro:content';
import ChipLayout from '@layouts/ChipLayout.astro';

// 910B4 = 3500 G3 的别名（同款机器的不同代号）
// 此页面作为 alias 入口，所有数据与实测请访问主页 3500 G3
const entry = await getEntry('chips', '910b4');
if (!entry) throw new Error('910b4 not found');
const data = entry.data;

const headings = [
  { depth: 2, slug: 'alias', text: '910B4 = 3500 G3' },
  { depth: 2, slug: 'sources', text: '数据来源' }
];

const leftNav = [
  {
    title: '芯片 / 服务器',
    items: [
      { href: '/chips/3500-g3', label: '3500 G3 (910B4)' },
      { href: '/chips/910c', label: '910C' },
      { href: '/chips/950', label: '950 (路线图)' }
    ]
  },
  {
    title: '模型与基准',
    items: [
      { href: '/models', label: '模型适配总表' },
      { href: '/benchmarks/ttft', label: 'TTFT' },
      { href: '/benchmarks/throughput', label: '吞吐' },
      { href: '/benchmarks/e2e', label: 'E2E' }
    ]
  }
];
---

<ChipLayout
  title="910B4 = 3500 G3 · Ascend Notes"
  description="910B4 是 HuaKun AT3500 G3 的华为内部代号，两者指向同一台机器。"
  breadcrumb={[
    { label: '首页', href: '/' },
    { label: '芯片', href: '/' },
    { label: '910B4' }
  ]}
  leftNav={leftNav}
  headings={headings}
>
  <header class="mb-8">
    <div class="text-meta text-sm mb-2">别名页 · 与 3500 G3 合并</div>
    <h1 class="h1-title">昇腾 910B4</h1>
    <p class="mt-3 text-ink-700 dark:text-ink-200">
      910B4 是华为对 <b>昇腾 910 推理芯片</b>的内部代号，搭载该芯片的整机 SKU 在华鲲振宇称为
      <b>HuaKun AT3500 G3</b>（也称 <code class="font-mono">Atlas 800I A2</code>）。
      三者指向同一台机器，本档案统一在 <a href="/chips/3500-g3" class="text-brand underline">3500 G3</a> 页面记录。
    </p>
  </header>

  <div class="not-prose rounded-lg border border-default bg-page-2 p-6 mb-8">
    <div class="text-sm text-meta mb-2">本页数据已合并</div>
    <div class="text-base mb-4">所有硬件规格、模型适配与实测性能请前往主页：</div>
    <a href="/chips/3500-g3" class="inline-flex items-center gap-2 px-4 py-2 rounded bg-brand text-white text-sm font-medium hover:opacity-90">
      → 前往 3500 G3 主页
    </a>
  </div>

  <h2 id="alias" class="anchor-offset h2-title">910B4 = 3500 G3</h2>
  <ul class="text-ink-700 dark:text-ink-200 space-y-1.5">
    <li><b>910B4</b>：华为昇腾芯片代号（也写作 910B）</li>
    <li><b>HuaKun AT3500 G3</b>：华鲲振宇整机 SKU 名（也叫 AT3500 G3、3500 G3）</li>
    <li><b>Atlas 800I A2</b>：华为服务器产品线代号</li>
    <li><b>三者硬件完全相同</b>：单机 8 卡 64GB HBM2e，鲲鹏 920 + 昇腾 910B4</li>
  </ul>

  <p class="mt-6 text-meta">
    原 910B4 页面记录的 Qwen3 / DeepSeek-V4 等中小模型实测，已合并到 <a href="/chips/3500-g3" class="text-brand underline">3500 G3 主页 §4.1</a>。
  </p>

  <h2 id="sources" class="anchor-offset h2-title">数据来源</h2>
  <ul class="text-ink-700 dark:text-ink-200 space-y-1.5 text-sm">
    <li>· <a href="/chips/3500-g3" class="text-brand underline">3500 G3 主页</a>（合并后唯一权威数据源）</li>
    <li>· 华鲲昇腾产品介绍 PPT（src-006，2026-08）</li>
    <li>· HuaKun AT3500 G3 lab 参数汇总（src-009，2026-09-23）</li>
  </ul>
</ChipLayout>
