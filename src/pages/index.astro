---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import ChipCard from '@components/ChipCard.astro';
import DataTable from '@components/DataTable.astro';
import ChartBlock from '@components/ChartBlock.astro';
import Footnote from '@components/Footnote.astro';

const chips = await getCollection('chips');

// 关键快照数据：3500 G3 vs 910C 在同一档并发下的 TTFT 对比
const snapshotRows = [
  { device: '3500 G3 ×16 卡', model: 'DeepSeek-R1-671B Int8', concurrency: 30, ttft_ms: '1586.94', tpot_ms: '56.42', throughput: '1010.78 tps' },
  { device: '910C 单机',     model: 'DeepSeek-V4-Flash W8A8', concurrency: 64, ttft_ms: '~11000', tpot_ms: '—', throughput: '6694.92 tps' },
  { device: '910C 双机',     model: 'DeepSeek-V4-Pro W4A8', concurrency: 16, ttft_ms: '~5600', tpot_ms: '—', throughput: '2127.68 tps' },
  { device: '910B 单机',     model: 'DeepSeek-V4-Flash W8A8', concurrency: 16, ttft_ms: '~2100', tpot_ms: '—', throughput: '775.74 tps' },
  { device: '910B 四卡',     model: 'DeepSeek-V4-Pro W4A8', concurrency: 16, ttft_ms: '~6200', tpot_ms: '—', throughput: '963.4 tps' }
];

// 首页图表：吞吐对比
const tpsChartOption = {
  tooltip: { trigger: 'axis' },
  grid: { left: 60, right: 20, top: 30, bottom: 60 },
  xAxis: {
    type: 'category',
    data: ['3500 G3 ×16\nDS-R1-671B Int8', '910C 单机\nDS-V4-Flash', '910C 双机\nDS-V4-Pro', '910B 单机\nDS-V4-Flash', '910B 四卡\nDS-V4-Pro'],
    axisLabel: { fontSize: 10 }
  },
  yAxis: { type: 'value', name: '吞吐 (tps)' },
  series: [{
    type: 'bar',
    data: [1010.78, 6694.92, 2127.68, 775.74, 963.4],
    itemStyle: { color: '#06c' },
    label: { show: true, position: 'top', fontSize: 10 }
  }]
};
---

<BaseLayout title="Ascend Notes · 昇腾实测档案">
  <!-- Hero -->
  <section class="border-b border-default">
    <div class="container-shell py-14 md:py-20">
      <div class="max-w-3xl">
        <div class="text-meta text-sm mb-3">昇腾推理实测档案 · Ascend Notes</div>
        <h1 class="text-4xl md:text-5xl font-semibold tracking-tight text-ink-900 dark:text-ink-100">
          Ascend 3500 G3 · 910B4 · 910C · 950
        </h1>
        <p class="mt-4 text-lg text-ink-700 dark:text-ink-200">
          模型适配矩阵、首 token 延迟 (TTFT)、并发与吞吐实测。
          每条数据都标注硬件、CANN/MindIE 版本、prompt/output 长度和来源笔记。
        </p>
        <p class="mt-3 text-meta">
          术语：<span class="font-mono">TTFT</span> = 首 token 延迟 / 首包延迟 ·
          <span class="font-mono">TPOT</span> = 非首 token 平均延迟 ·
          <span class="font-mono">E2E</span> = 端到端
        </p>
      </div>
    </div>
  </section>

  <!-- 芯片速览 -->
  <section class="container-shell py-12">
    <h2 class="h2-title mt-0">四款芯片 / 服务器</h2>
    <p class="text-meta mb-6">硬件参数（带宽 / 显存 / 算力）是基础，性能表现（延迟 / 吞吐 / 显示效果）是应用。</p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 not-prose">
      {chips.map(c => (
        <ChipCard
          href={`/chips/${c.id}`}
          title={c.data.chip_short}
          subtitle={c.data.category === 'legacy' ? '主力 / 满血 671B'
            : c.data.category === 'mainstream' ? '主流 / 70B 以下'
            : c.data.category === 'flagship' ? '旗舰 / 新一代'
            : '路线图'}
          meta={[
            `${c.data.memory.per_card_gb ?? '?'}GB × ${c.data.memory.type}`,
            `FP16 ${c.data.compute.fp16_tflops ?? '?'} TFLOPS`,
            `互联 ${c.data.interconnect.bandwidth_gbps ?? '?'} GB/s`
          ]}
          status={c.data.status}
        />
      ))}
    </div>
  </section>

  <!-- 性能板块（强调：第二大板块） -->
  <section class="bg-page-2 border-y border-default">
    <div class="container-shell py-12">
      <div class="flex items-baseline gap-3 mb-2">
        <h2 class="h2-title mt-0 mb-0">性能 · 第二大板块</h2>
        <span class="text-meta text-sm">数字告诉你有多快，输出告诉你有多能</span>
      </div>
      <p class="text-meta mb-6 max-w-3xl">
        性能记录分四块：<b>① 性能基线</b> · <b>② 装模型的显示效果</b>（实际输出）·
        <b>③ 跑大模型的延迟</b>（TTFT/TPOT/E2E）· <b>④ 吞吐与并发</b>。
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 not-prose mb-8">
        <a href="/benchmarks/throughput" class="card card-hover block">
          <div class="text-meta text-xs uppercase tracking-wider mb-1">① 性能基线</div>
          <div class="font-semibold mb-1">吞吐 / 基准对比</div>
          <div class="text-sm text-ink-600 dark:text-ink-300">同一档测试下的吞吐排名 + 同芯片对比</div>
        </a>
        <a href="/demos" class="card card-hover block">
          <div class="text-meta text-xs uppercase tracking-wider mb-1">② 显示效果</div>
          <div class="font-semibold mb-1">模型实际输出</div>
          <div class="text-sm text-ink-600 dark:text-ink-300">问答 / 推理 / 代码 / 长上下文四类任务的实际响应</div>
        </a>
        <a href="/benchmarks/ttft" class="card card-hover block">
          <div class="text-meta text-xs uppercase tracking-wider mb-1">③ 延迟</div>
          <div class="font-semibold mb-1">TTFT / TPOT / E2E</div>
          <div class="text-sm text-ink-600 dark:text-ink-300">首 token 延迟、非首 token 延迟、端到端</div>
        </a>
        <a href="/benchmarks/throughput" class="card card-hover block">
          <div class="text-meta text-xs uppercase tracking-wider mb-1">④ 吞吐 + 并发</div>
          <div class="font-semibold mb-1">Tokens/s × Concurrency</div>
          <div class="text-sm text-ink-600 dark:text-ink-300">总吞吐 / 单并发 / 并发上限</div>
        </a>
      </div>

      <h3 class="h3-title">最新性能快照 · 2026-09</h3>
      <p class="text-meta mb-4">
        同一档测试条件下的吞吐对比。注意不同设备的模型与量化方案不同，绝对值仅作参考。
      </p>

      <ChartBlock
        id="home-tps-chart"
        option={tpsChartOption}
        height="320px"
        caption="吞吐对比 (tps) — 横轴为 设备 / 模型 组合"
      />

      <DataTable
        caption="实测数据明细"
        columns={[
          { key: 'device', label: '设备' },
          { key: 'model', label: '模型 · 量化' },
          { key: 'concurrency', label: '并发', align: 'right', mono: true },
          { key: 'ttft_ms', label: 'TTFT', align: 'right', mono: true },
          { key: 'tpot_ms', label: 'TPOT', align: 'right', mono: true },
          { key: 'throughput', label: '吞吐', align: 'right', mono: true }
        ]}
        rows={snapshotRows}
      />
    </div>
  </section>

  <!-- 模型适配矩阵 -->
  <section class="container-shell py-12">
    <h2 class="h2-title mt-0">模型适配矩阵</h2>
    <p class="text-meta mb-4">摘要版。完整筛选见 <a href="/models">/models</a>。</p>

    <div class="overflow-x-auto rounded-md border border-default not-prose">
      <table class="data-table">
        <thead>
          <tr>
            <th>模型</th>
            <th>参数量</th>
            <th class="text-center">3500 G3</th>
            <th class="text-center">910B4</th>
            <th class="text-center">910C</th>
            <th class="text-center">950</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>DeepSeek-R1-671B</td><td class="text-meta">671B MoE</td><td class="text-center">✓ Int8</td><td class="text-center">—</td><td class="text-center">—</td><td class="text-center">—</td></tr>
          <tr><td>DeepSeek-V4-Flash</td><td class="text-meta">激活 ~4B</td><td class="text-center">—</td><td class="text-center">✓ W8A8</td><td class="text-center">✓ W8A8</td><td class="text-center">—</td></tr>
          <tr><td>DeepSeek-V4-Pro</td><td class="text-meta">激活 ~22B</td><td class="text-center">—</td><td class="text-center">✓ W4A8</td><td class="text-center">✓ W4A8</td><td class="text-center">—</td></tr>
          <tr><td>GLM5</td><td class="text-meta">—</td><td class="text-center">—</td><td class="text-center">—</td><td class="text-center">✓ W4A8</td><td class="text-center">—</td></tr>
          <tr><td>Qwen3-235B-A22B</td><td class="text-meta">235B MoE</td><td class="text-center">—</td><td class="text-center">✓ FP16</td><td class="text-center">—</td><td class="text-center">—</td></tr>
          <tr><td>Qwen3-30B-A3B</td><td class="text-meta">30B MoE</td><td class="text-center">—</td><td class="text-center">✓ W8A8</td><td class="text-center">—</td><td class="text-center">—</td></tr>
          <tr><td>Qwen3-32B</td><td class="text-meta">32B</td><td class="text-center">—</td><td class="text-center">✓ W8A8</td><td class="text-center">—</td><td class="text-center">—</td></tr>
          <tr><td>DeepSeek-70B</td><td class="text-meta">70B</td><td class="text-center">—</td><td class="text-center">✓ W4A16</td><td class="text-center">—</td><td class="text-center">—</td></tr>
        </tbody>
      </table>
    </div>

    <div class="mt-3 text-meta text-sm">
      <span class="badge badge-verified mr-2">已验证</span>
      <span class="badge badge-partial mr-2">部分验证</span>
      <span class="badge badge-unsupported mr-2">不支持</span>
      <span>— 未测 / 未覆盖</span>
    </div>
  </section>

  <!-- 数据来源 + 方法论入口 -->
  <section class="container-shell py-12">
    <div class="grid md:grid-cols-2 gap-6 not-prose">
      <a href="/methodology" class="card card-hover block">
        <div class="text-meta text-xs uppercase tracking-wider mb-1">方法论</div>
        <div class="font-semibold text-lg mb-1">测试方法 · 术语表</div>
        <div class="text-sm text-ink-600 dark:text-ink-300">
          TTFT / TPOT / E2E 的定义、CANN/MindIE 版本对照、prompt/output 配置
        </div>
      </a>
      <a href="/sources" class="card card-hover block">
        <div class="text-meta text-xs uppercase tracking-wider mb-1">来源</div>
        <div class="font-semibold text-lg mb-1">资料与来源清单</div>
        <div class="text-sm text-ink-600 dark:text-ink-300">
          内部 PPT/Excel/Word 笔记 + vLLM Ascend 官方文档，共 9 条
        </div>
      </a>
    </div>

    <div class="mt-8">
      <Footnote sources={[
        { id: 'src-001', title: '3500G3 性能基线', date: '2026-09-23' },
        { id: 'src-002', title: '910C/910B 跑 DeepSeek-V4 数据汇总', date: '2026-09-23' },
        { id: 'src-005', title: 'DeepSeek V4 模型性能基线 (Excel)', date: '2026-09-23' }
      ]} />
    </div>
  </section>
</BaseLayout>
