---
import BaseLayout from '@layouts/BaseLayout.astro';
import DataTable from '@components/DataTable.astro';
import ChartBlock from '@components/ChartBlock.astro';
import Footnote from '@components/Footnote.astro';
import { getCollection } from 'astro:content';

const chips = await getCollection('chips');
const shippingChips = chips.filter(c => c.data.status === 'shipping');

const points = shippingChips.flatMap(c =>
  c.data.models
    .filter(m => m.throughput_tps != null)
    .map(m => ({
      chip: c.data.chip_short,
      model: m.model,
      quantization: m.quantization,
      cards: m.cards,
      config: m.config ?? '',
      throughput_tps: m.throughput_tps
    }))
);

points.sort((a, b) => b.throughput_tps - a.throughput_tps);

const chartOption = {
  tooltip: { trigger: 'axis' },
  legend: { data: ['吞吐 (tps)'], top: 0 },
  grid: { left: 60, right: 20, top: 40, bottom: 80 },
  xAxis: {
    type: 'category',
    data: points.map(p => `${p.chip}\n${p.model}`),
    axisLabel: { rotate: 30, fontSize: 9 }
  },
  yAxis: { type: 'value', name: '吞吐 (tps)' },
  series: [{
    type: 'bar',
    data: points.map(p => p.throughput_tps),
    itemStyle: { color: '#06c' }
  }]
};
---

<BaseLayout title="吞吐 (Throughput) · Ascend Notes">
  <div class="container-shell py-10">
    <nav aria-label="Breadcrumb" class="text-meta text-sm mb-4 not-prose">
      <ol class="flex items-center flex-wrap gap-1.5">
        <li><a href="/" class="hover:text-brand">首页</a></li>
        <li class="text-ink-400">›</li>
        <li class="text-ink-700 dark:text-ink-200">吞吐</li>
      </ol>
    </nav>

    <header class="mb-8 max-w-3xl">
      <div class="text-meta text-sm mb-2">基准 · Benchmarks</div>
      <h1 class="h1-title">吞吐 (Throughput)</h1>
      <p class="mt-3 text-ink-700 dark:text-ink-200">
        单位 tokens/s，分<b>总吞吐</b>（整集群）和<b>单卡吞吐</b>（每张卡）。
        本档案展示的是<b>总吞吐</b>。
      </p>
    </header>

    <ChartBlock
      id="tps-chart"
      option={chartOption}
      height="420px"
      caption="图：吞吐排名（按总吞吐降序）"
    />

    <DataTable
      caption="吞吐实测数据"
      columns={[
        { key: 'chip', label: '芯片' },
        { key: 'model', label: '模型' },
        { key: 'quantization', label: '量化', mono: true },
        { key: 'cards', label: '卡数', align: 'right', mono: true },
        { key: 'throughput_tps', label: '总吞吐 (tps)', align: 'right', mono: true },
        { key: 'config', label: '配置' }
      ]}
      rows={points}
    />

    <h2 class="h2-title">关键观察</h2>
    <ul class="text-ink-700 dark:text-ink-200 space-y-2 list-disc list-inside">
      <li><b>910C 单机 V4-Flash</b>（8k/1k, c=64）总吞吐 6694.92 tps，是当前所有实测中吞吐最高的"单机"配置。</li>
      <li><b>910C 双机 V4-Pro</b>（4k/1k, c=16）总吞吐 2127.68 tps。</li>
      <li><b>3500 G3 ×16 卡</b> 跑 DS-R1-671B Int8（4096/1024, c=30）总吞吐 2080.89 tps，是 671B 满血模型的最佳吞吐。</li>
    </ul>

    <Footnote sources={[
      { id: 'src-001', title: '3500G3 性能基线', date: '2026-09-23' },
      { id: 'src-002', title: '910C/910B 跑 DeepSeek-V4 数据汇总', date: '2026-09-23' },
      { id: 'src-005', title: 'DeepSeek V4 模型性能基线 (Excel)', date: '2026-09-23' }
    ]} />
  </div>
</BaseLayout>
