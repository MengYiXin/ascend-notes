---
import BaseLayout from '@layouts/BaseLayout.astro';
import DataTable from '@components/DataTable.astro';
import Footnote from '@components/Footnote.astro';
import { getCollection } from 'astro:content';

const chips = await getCollection('chips');
const shippingChips = chips.filter(c => c.data.status === 'shipping');

const points = shippingChips.flatMap(c =>
  c.data.models
    .filter(m => m.e2e_s != null)
    .map(m => ({
      chip: c.data.chip_short,
      model: m.model,
      quantization: m.quantization,
      cards: m.cards,
      config: m.config ?? '',
      e2e_s: m.e2e_s
    }))
);

points.sort((a, b) => a.e2e_s - b.e2e_s);
---

<BaseLayout title="端到端延迟 (E2E) · Ascend Notes">
  <div class="container-shell py-10">
    <nav aria-label="Breadcrumb" class="text-meta text-sm mb-4 not-prose">
      <ol class="flex items-center flex-wrap gap-1.5">
        <li><a href="/" class="hover:text-brand">首页</a></li>
        <li class="text-ink-400">›</li>
        <li class="text-ink-700 dark:text-ink-200">E2E</li>
      </ol>
    </nav>

    <header class="mb-8 max-w-3xl">
      <div class="text-meta text-sm mb-2">基准 · Benchmarks</div>
      <h1 class="h1-title">端到端延迟 (E2E)</h1>
      <p class="mt-3 text-ink-700 dark:text-ink-200">
        E2E = End-to-End，从请求发起到完整响应结束的总耗时。
        单并发场景下，E2E ≈ TTFT + 输出 token 数 × TPOT。
      </p>
    </header>

    <DataTable
      caption="E2E 实测数据（按 E2E 升序）"
      columns={[
        { key: 'chip', label: '芯片' },
        { key: 'model', label: '模型' },
        { key: 'quantization', label: '量化', mono: true },
        { key: 'cards', label: '卡数', align: 'right', mono: true },
        { key: 'e2e_s', label: 'E2E (s)', align: 'right', mono: true },
        { key: 'config', label: '配置' }
      ]}
      rows={points}
    />

    <h2 class="h2-title">说明</h2>
    <ul class="text-ink-700 dark:text-ink-200 space-y-2 list-disc list-inside">
      <li>910B4 跑 Qwen3-32B / 30B-A3B (p=2k, o=2k, c=25)，E2E ≈ 4s，对应 TPS 340。</li>
      <li>910C 双机 V4-Pro 1M 上下文，E2E 长达 798 小时——这是 Prefix Cache 失效场景的极端值，1M 上下文当前无法走生产。</li>
    </ul>

    <Footnote sources={[
      { id: 'src-002', title: '910C/910B 跑 DeepSeek-V4 数据汇总', date: '2026-09-23' },
      { id: 'src-003', title: '请教蒲谋：Qwen3 / DeepSeek 在 910B4 上的部署', date: '2026-09-23' },
      { id: 'src-005', title: 'DeepSeek V4 模型性能基线 (Excel)', date: '2026-09-23' }
    ]} />
  </div>
</BaseLayout>
