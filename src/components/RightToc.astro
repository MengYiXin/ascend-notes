---
interface Heading { depth: number; slug: string; text: string }
interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{tocHeadings.length > 0 && (
  <aside class="hidden xl:block w-48 shrink-0">
    <nav class="sticky top-20 text-sm">
      <div class="text-meta uppercase tracking-wider text-xs font-medium mb-2">
        本页目录
      </div>
      <ul class="space-y-1.5 border-l border-default pl-3">
        {tocHeadings.map(h => (
          <li class:list={[h.depth === 3 && 'ml-3']}>
            <a
              href={`#${h.slug}`}
              class="text-ink-600 dark:text-ink-300 hover:text-brand transition-colors"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </aside>
)}
