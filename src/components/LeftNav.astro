---
interface Section {
  title: string;
  items: { href: string; label: string; badge?: string }[];
}
interface Props {
  sections: Section[];
  currentPath: string;
}
const { sections, currentPath } = Astro.props;
---

<aside class="hidden lg:block w-56 shrink-0">
  <nav class="sticky top-20 space-y-6 text-sm">
    {sections.map(section => (
      <div>
        <div class="text-meta uppercase tracking-wider text-xs font-medium mb-2 px-2">
          {section.title}
        </div>
        <ul class="space-y-0.5">
          {section.items.map(item => {
            const active = currentPath === item.href ||
              (item.href !== '/' && currentPath.startsWith(item.href));
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'flex items-center justify-between px-2 py-1.5 rounded transition-colors',
                    active
                      ? 'bg-brand/10 text-brand dark:text-brand-dark font-medium'
                      : 'text-ink-700 dark:text-ink-200 hover:bg-page-2'
                  ]}
                >
                  <span>{item.label}</span>
                  {item.badge && <span class="text-[10px] text-meta">{item.badge}</span>}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </nav>
</aside>
