---
interface Props {
  href: string;
  title: string;
  subtitle: string;
  meta: string[];
  status: string;
}
const { href, title, subtitle, meta, status } = Astro.props;
---

<a href={href} class="card card-hover block group">
  <div class="flex items-start justify-between gap-3">
    <div>
      <div class="text-meta text-xs uppercase tracking-wider mb-1">{subtitle}</div>
      <div class="font-semibold text-ink-900 dark:text-ink-100 text-lg group-hover:text-brand transition-colors">
        {title}
      </div>
    </div>
    <span class:list={[
      'badge',
      status === 'shipping' && 'badge-verified',
      status === 'preview' && 'badge-partial',
      status === 'roadmap' && 'badge-untested'
    ]}>
      {status === 'shipping' ? '在售' : status === 'preview' ? '预览' : '路线图'}
    </span>
  </div>
  <div class="mt-3 text-meta text-sm space-y-0.5">
    {meta.map(m => <div>{m}</div>)}
  </div>
</a>
